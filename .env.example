# Bot Token and channel ID are configured in the web UI; no API ID/hash required.
# Required for a VPS behind HTTPS reverse proxy. Use the browser's exact origin.
TGPAN_PUBLIC_ORIGIN=https://drive.example.com
TGPAN_SECURE_COOKIE=true
# Comma-separated trusted proxy IPs/CIDRs. For Docker use the actual gateway IP.
TGPAN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# API documentation is disabled by default, including in production.
TGPAN_ENABLE_API_DOCS=false
# Optional socks5://user:password@host:port or http://host:port
TGPAN_PROXY_URL=
# Byte counts. Storage block size must be a multiple of HTTP chunk size.
TGPAN_MAX_FILE_SIZE=5000000000
TGPAN_CHUNK_SIZE=4194304
TGPAN_BLOCK_SIZE=16777216
TGPAN_TEMP_LIMIT=2147483648
TGPAN_UPLOAD_TTL=86400
TGPAN_SESSION_DAYS=7
